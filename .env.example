# ─── Application ────────────────────────────────────────────────
NODE_ENV=development
CORS_ORIGINS=http://localhost:3100,http://localhost:3101,http://localhost:3102

# ─── API Gateway ────────────────────────────────────────────────
GATEWAY_PORT=3000

# ─── Auth Service ───────────────────────────────────────────────
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=3001
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change-this-to-another-long-random-string-min-32-chars
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# ─── Tenants Service ────────────────────────────────────────────
TENANTS_SERVICE_HOST=localhost
TENANTS_SERVICE_PORT=3002

# ─── Users Service ──────────────────────────────────────────────
USERS_SERVICE_HOST=localhost
USERS_SERVICE_PORT=3003

# ─── Vehicles Service ───────────────────────────────────────────
VEHICLES_SERVICE_HOST=localhost
VEHICLES_SERVICE_PORT=3004

# ─── Leads Service ──────────────────────────────────────────────
LEADS_SERVICE_HOST=localhost
LEADS_SERVICE_PORT=3005

# ─── Orders Service ─────────────────────────────────────────────
ORDERS_SERVICE_HOST=localhost
ORDERS_SERVICE_PORT=3006

# ─── Notifications Service ──────────────────────────────────────
NOTIFICATIONS_SERVICE_HOST=localhost
NOTIFICATIONS_SERVICE_PORT=3007

# ─── Media Service ──────────────────────────────────────────────
MEDIA_SERVICE_HOST=localhost
MEDIA_SERVICE_PORT=3008

# ─── Analytics Service ──────────────────────────────────────────
ANALYTICS_SERVICE_HOST=localhost
ANALYTICS_SERVICE_PORT=3009

# ─── Payments Service ───────────────────────────────────────────
PAYMENTS_SERVICE_HOST=localhost
PAYMENTS_SERVICE_PORT=3010

# ─── SQL Server ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=YourStrong@Passw0rd
DB_DATABASE=autonova
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_ENCRYPT=false

# ─── Redis ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Cloudinary (Vehicle Images) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Resend (Transactional Email) ───────────────────────────────
RESEND_API_KEY=

# ─── Twilio (SMS) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Stripe (UK / Global Payments) ──────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ─── Paystack (Nigeria / Africa Payments) ───────────────────────
PAYSTACK_SECRET_KEY=sk_test_
PAYSTACK_PUBLIC_KEY=pk_test_

# ─── Next.js Frontend URLs ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3101
NEXT_PUBLIC_ADMIN_URL=http://localhost:3102
